{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : accès minimal aux fenêtres et à nos propres commandes",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:default",
    "updater:default",
    "process:allow-restart",
    "allow-ping",
    "allow-etat-initial",
    "allow-installer-adb",
    "allow-chercher-box",
    "allow-connecter",
    "allow-chercher-villes",
    "allow-inventaire",
    "allow-installer",
    "allow-appliquer",
    "allow-verifier",
    "allow-restaurer",
    "allow-decider",
    "allow-annuler",
    "allow-couper-debogage",
    "allow-ouvrir-sauvegardes",
    "allow-rapport-texte",
    "allow-envoyer-rapport",
    "allow-desinstaller-mac"
  ]
}
